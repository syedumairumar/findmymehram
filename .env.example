# Leave blank for the explicitly labelled, browser-local demo.
# For real local accounts, run npm run backend:env after backend:start.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# OAuth providers need configuring in Supabase before these are enabled.
VITE_GOOGLE_AUTH_ENABLED=false
VITE_FACEBOOK_AUTH_ENABLED=false
# Enable only after the call migration, relay function and two-device tests.
VITE_CALLS_ENABLED=false
# Provider checkout is disabled until server secrets/functions are configured.
VITE_PAYMENTS_ENABLED=false
# Must remain sandbox for this test release.
VITE_PAYMENT_ENVIRONMENT=sandbox
